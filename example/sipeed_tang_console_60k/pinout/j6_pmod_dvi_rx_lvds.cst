# Receiving DVI on the J6 Pmod.
#
# The pairs are the ones nsl_sipeed.pmod_dvi drives when transmitting:
# clock on Pmod 4/8, data0 on 3/7, data1 on 2/6, data2 on 1/5.  Both
# pins of a pair are placed.
#
# The Pmod terminates each pair at the connector and reconstructs a
# 1.65V common mode on this side, which is what a differential
# receiver here needs.

IO_LOC  "dvi_ck_i" C22,B22;
IO_PORT "dvi_ck_i" IO_TYPE=LVDS25 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC  "dvi_d_i[0]" F18,E18;
IO_PORT "dvi_d_i[0]" IO_TYPE=LVDS25 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC  "dvi_d_i[1]" G21,G22;
IO_PORT "dvi_d_i[1]" IO_TYPE=LVDS25 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC  "dvi_d_i[2]" V18,V19;
IO_PORT "dvi_d_i[2]" IO_TYPE=LVDS25 PULL_MODE=NONE BANK_VCCIO=3.3;
