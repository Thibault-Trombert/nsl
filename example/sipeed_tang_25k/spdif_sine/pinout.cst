# Sipeed PMOD-Ethernet on J4: RJ45 4/5 is PMOD 2/6 (D11/D10).
# The other windings share center taps.  Opposite weak pulls on their
# released ends keep the common-mode voltage near the input midpoint.
IO_LOC  "j4_io[1]" G11;
IO_PORT "j4_io[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "j4_io[5]" G10;
IO_PORT "j4_io[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "j4_io[2]" D11;
IO_PORT "j4_io[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16 BANK_VCCIO=3.3;
IO_LOC  "j4_io[6]" D10;
IO_PORT "j4_io[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16 BANK_VCCIO=3.3;
IO_LOC  "j4_io[3]" B11;
IO_PORT "j4_io[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "j4_io[7]" B10;
IO_PORT "j4_io[7]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "j4_io[4]" C11;
IO_PORT "j4_io[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "j4_io[8]" C10;
IO_PORT "j4_io[8]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
